# Copy to .env and replace the examples with your own values.
# Existing process environment variables override this file.
# The two owners share management, private mailbox and pet care permissions.
QN_ADMIN_USERS='["管理员用户名1", "管理员用户名2"]'
# Wedding roles use account names, independently of display nicknames.
QN_WEDDING_GROOM_USER=管理员用户名1
QN_WEDDING_BRIDE_USER=管理员用户名2
QN_CHECK_CODE=replace-with-your-registration-share-code
# Exact pages ordinary users may access. New pages are denied by default.
# /index remains the landing page. Add /journey to grant read-only journey access.
QN_USER_PAGE_ALLOWLIST='["/index","/pet","/wedding"]'
# Optional: use one stable JWT key across deployments.
# QN_SECRET_KEY=replace-with-a-long-random-secret
QN_BACKEND_PORT=1277
QN_FRONTEND_PORT=7721
# Sakura Frp public entry; the tunnel should target 127.0.0.1:7721.
QN_PUBLIC_URL=http://frp-way.com:35509
# Additional exact hostnames for development tunnels, comma-separated (no port).
QN_ALLOWED_HOSTS=frp-way.com
