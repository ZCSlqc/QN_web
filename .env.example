# Copy to .env. Keep real secrets only in .env or the process environment.
# Existing process environment variables override this file.

QN_ADMIN_USERS=["李琪淳", "郑丹妮"]
QN_WEDDING_GROOM_USER=李琪淳
QN_WEDDING_BRIDE_USER=郑丹妮
QN_CHECK_CODE=replace-with-your-registration-share-code
QN_USER_PAGE_ALLOWLIST=["/index","/pet","/wedding"]

# Sakura Frp: frp-way.com:35509 -> 127.0.0.1:7721
QN_BACKEND_PORT=1277
QN_FRONTEND_PORT=7721
QN_PUBLIC_URL=http://frp-way.com:35509
QN_ALLOWED_HOSTS=frp-way.com

# Optional stable JWT key; leave unset to use the local ignored .secret_key file.
# QN_SECRET_KEY=replace-with-a-long-random-secret
